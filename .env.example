# =============================================================================
# ba-account-swarm - Environment Configuration
# Copy this file to .env and adjust values for your local setup.
# =============================================================================

# --- LLM / Ollama -----------------------------------------------------------
# Base URL of local Ollama instance (OpenAI-compatible API).
LLM_BASE_URL=http://localhost:11434/v1

# API key required by the OpenAI SDK interface; "ollama" works for local instances.
LLM_API_KEY=ollama

# Primary model used for full agent reasoning, tool routing, and complex prompts.
LLM_MODEL=qwen3.6

# Faster, cheaper model used for classification/splitting tasks (e.g., intent).
FAST_LLM_MODEL=qwen3.6

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- SQLite Persistence ---------------------------------------------------------
DB_PATH=ba_account_swarm.db

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
SWARM_HEARTBEAT_INTERVAL_MINUTES=5

# --- Optional: external service API keys (all can be left blank for pure local)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
JIRA_BASE_URL=
JIRA_API_TOKEN=
GMAIL_CLIENT_EMAIL=
GMAIL_PRIVATE_KEY_PATH=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_WHATSAPP_ACCESS_TOKEN=
